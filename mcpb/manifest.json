{
  "manifest_version": "0.3",
  "name": "imessage-max",
  "display_name": "iMessage Max",
  "version": "1.8.0",
  "description": "Local MCP server for reading, searching, and sending iMessages on macOS.",
  "long_description": "iMessage Max gives AI agents MCP tools that match what users ask for: search local iMessages, inspect a conversation, fetch attachments, triage unread messages, and send through Messages.app. The extension connects Claude to the iMessage Max app running on this Mac, which holds the permissions to read Messages, so Claude needs none of its own. Install and open the iMessage Max app first.",
  "author": {
    "name": "Rob Dezendorf",
    "url": "https://github.com/cyberpapiii"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyberpapiii/imessage-max.git"
  },
  "homepage": "https://github.com/cyberpapiii/imessage-max",
  "documentation": "https://github.com/cyberpapiii/imessage-max#readme",
  "support": "https://github.com/cyberpapiii/imessage-max/issues",
  "icon": "assets/icon-128.png",
  "icons": [
    {
      "src": "assets/icon-16.png",
      "size": "16x16"
    },
    {
      "src": "assets/icon-32.png",
      "size": "32x32"
    },
    {
      "src": "assets/icon-64.png",
      "size": "64x64"
    },
    {
      "src": "assets/icon-128.png",
      "size": "128x128"
    },
    {
      "src": "assets/icon-256.png",
      "size": "256x256"
    },
    {
      "src": "assets/icon-512.png",
      "size": "512x512"
    }
  ],
  "server": {
    "type": "binary",
    "entry_point": "server/imessage-max",
    "mcp_config": {
      "command": "${__dirname}/server/imessage-max",
      "args": []
    }
  },
  "tools_generated": true,
  "keywords": [
    "imessage",
    "messages",
    "mcp",
    "macos",
    "productivity"
  ],
  "license": "MIT",
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": [
      "darwin"
    ]
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.cyberpapiii.imessage-max.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/imessage-max</string>
	<key>ProgramArguments</key>
	<array>
		<string>imessage-max</string>
		<string>--http</string>
		<string>--port</string>
		<string>8080</string>
		<string>--log-file</string>
		<string>~/Library/Logs/iMessage Max/imessage-max.log</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.cyberpapiii.imessage-max.menubar</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>Crashed</key>
		<true/>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>ProcessType</key>
	<string>Standard</string>
</dict>
</plist>
